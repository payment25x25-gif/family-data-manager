{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auth",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/auth/verify",
      "dest": "/api/auth.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
