# سر التشفير المستخدم لتوليد توكن تسجيل الدخول (JWT_SECRET)
# يجب أن تكون قيمة عشوائية وطويلة
JWT_SECRET="Your_Super_Secret_Key_For_JWT_Token_Generation_1234567890"

# بيانات المشرفين (اسم_المستخدم:الهاش_المشفر)
# الهاش المشفر لكلمة المرور "admin123" هو: 240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
# يمكنك إضافة مشرفين آخرين بفصلهم بفاصلة (,)
ADMIN_USERS="admin:240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9"
